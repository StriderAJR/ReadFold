  "grammar": [
    {
      "id": "grammar.topic",
      "title": "は: тема",
      "explanation": "Частица は выделяет тему: о ком или о чём говорится. Как частица читается わ (wa).",
      "examples": [
        {
          "text": "私は公園へ行きます。",
          "translation": "Я иду в парк."
        }
      ],
      "relatedIds": [
        "grammar.direction",
        "grammar.polite"
      ]
    },
    {
      "id": "grammar.direction",
      "title": "へ: направление",
      "explanation": "После места частица へ обозначает направление движения. Читается え (e).",
      "examples": [
        {
          "text": "公園へ行きます。",
          "translation": "Иду в парк."
        }
      ],
      "relatedIds": [
        "grammar.existence"
      ]
    },
    {
      "id": "grammar.polite",
      "title": "〜ます: вежливая форма",
      "explanation": "Основа глагола + ます образует вежливую непрошедшую форму: настоящее, привычное или будущее действие. 行く → 行きます; 飲む → 飲みます.",
      "examples": [
        {
          "text": "水を飲みます。",
          "translation": "Пью воду."
        }
      ],
      "relatedIds": [
        "grammar.progressive"
      ]
    },
    {
      "id": "grammar.existence",
      "title": "に〜がいます: наличие живого",
      "explanation": "Место + に, живое существо + が, затем います: кто-то находится в указанном месте. Известное существо можно выделить темой с は. います — вежливая форма いる.",
      "examples": [
        {
          "text": "公園に猫がいます。",
          "translation": "В парке есть кошка."
        }
      ],
      "relatedIds": [
        "grammar.location",
        "grammar.topic"
      ]
    },
    {
      "id": "grammar.location",
      "title": "で: место действия",
      "explanation": "Частица で указывает, где происходит действие. Для местонахождения с いる используется に.",
      "examples": [
        {
          "text": "木の下で水を飲みます。",
          "translation": "Пью воду под деревом."
        }
      ],
      "relatedIds": [
        "grammar.existence"
      ]
    },
    {
      "id": "grammar.possession",
      "title": "の: связь существительных",
      "explanation": "Первое существительное определяет второе: 木の下 — место под деревом, 次の日 — следующий день.",
      "examples": [
        {
          "text": "木の下に猫がいます。",
          "translation": "Под деревом есть кошка."
        }
      ],
      "relatedIds": [
        "grammar.existence"
      ]
    },
    {
      "id": "grammar.object",
      "title": "を: объект действия",
      "explanation": "Частица を (читается お, o) отмечает прямое дополнение: 水を飲む — пить воду.",
      "examples": [
        {
          "text": "猫に水をあげます。",
          "translation": "Даю кошке воду."
        }
      ],
      "relatedIds": [
        "grammar.recipient"
      ]
    },
    {
      "id": "grammar.progressive",
      "title": "〜ている: действие в процессе",
      "explanation": "Форма на て + いる может описывать текущее действие. 飲む → 飲んでいる; вежливо 飲んでいます.",
      "examples": [
        {
          "text": "猫は水を飲んでいます。",
          "translation": "Кошка пьёт воду."
        }
      ],
      "relatedIds": [
        "grammar.polite"
      ]
    },
    {
      "id": "grammar.recipient",
      "title": "に: получатель",
      "explanation": "С あげる частица に отмечает получателя, а を — то, что дают.",
      "examples": [
        {
          "text": "私は猫に水をあげます。",
          "translation": "Я даю кошке воду."
        }
      ],
      "relatedIds": [
        "grammar.object"
      ]
    }
  ]
}
