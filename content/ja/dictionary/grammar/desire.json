{
  "id": "ja:grammar:desire",
  "title": "〜たい: желание сделать",
  "explanation": "Добавьте たい к основе глагола, чтобы сказать, что хотите выполнить действие: 食べる → 食べたい (хотеть поесть).",
  "examples": [
    {
      "text": "寿司が食べたい。",
      "translation": "Хочу суши.",
      "hiragana": "すしがたべたい。",
      "romaji": "Sushi ga tabetai.",
      "literal": "Суши [субъект желания] хочу съесть.",
      "natural": "Хочу суши.",
      "segments": [
        {
          "text": "寿司",
          "reading": "すし"
        },
        {
          "text": "が"
        },
        {
          "text": "食",
          "reading": "た"
        },
        {
          "text": "べたい。"
        }
      ]
    }
  ],
  "relatedIds": [
