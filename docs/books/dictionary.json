    {
      "id": "grammar.progressive",
      "title": "〜ている: действие в процессе",
      "explanation": "Форма на て + いる может описывать текущее действие. 飲む → 飲んでいる; вежливо 飲んでいます.",
      "examples": [
        {
          "text": "猫は水を飲んでいます。",
          "translation": "Кошка пьёт воду.",
          "hiragana": "ねこはみずをのんでいます。",
          "romaji": "Neko wa mizu o nonde imasu.",
          "literal": "Кошка [тема] воду [объект] пьёт [действие в процессе].",
          "natural": "Кошка пьёт воду.",
          "segments": [
            {
              "text": "猫",
              "reading": "ねこ"
            },
            {
              "text": "は"
            },
            {
              "text": "水",
              "reading": "みず"
            },
            {
              "text": "を"
            },
            {
              "text": "飲",
              "reading": "の"
            },
            {
              "text": "んでいます。"
            }
          ]
        }
      ],
      "relatedIds": [
        "grammar.polite"
      ]
    },
    {
