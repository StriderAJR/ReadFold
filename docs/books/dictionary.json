  "grammar": [
    {
      "id": "grammar.topic",
      "title": "は: тема",
      "explanation": "Частица は выделяет тему: о ком или о чём говорится. Как частица читается わ (wa).",
      "examples": [
        {
          "text": "私は公園へ行きます。",
          "translation": "Я иду в парк.",
          "hiragana": "わたしはこうえんへいきます。",
          "romaji": "Watashi wa kōen e ikimasu.",
          "literal": "Я [тема] парк [направление] иду.",
          "natural": "Я иду в парк.",
          "segments": [
            {
              "text": "私",
              "reading": "わたし"
            },
            {
              "text": "は"
            },
            {
              "text": "公園",
              "reading": "こうえん"
            },
            {
              "text": "へ"
            },
            {
              "text": "行",
              "reading": "い"
            },
            {
              "text": "きます。"
            }
          ]
        }
      ],
      "relatedIds": [
        "grammar.direction",
        "grammar.polite"
      ]
    },
    {
      "id": "grammar.direction",
      "title": "へ: направление",
      "explanation": "После места частица へ обозначает направление движения. Читается え (e).",
      "examples": [
        {
          "text": "公園へ行きます。",
          "translation": "Иду в парк.",
          "hiragana": "こうえんへいきます。",
          "romaji": "Kōen e ikimasu.",
          "literal": "Парк [направление] иду.",
          "natural": "Иду в парк.",
          "segments": [
            {
              "text": "公園",
              "reading": "こうえん"
            },
            {
              "text": "へ"
            },
            {
              "text": "行",
              "reading": "い"
            },
            {
              "text": "きます。"
            }
          ]
        }
      ],
      "relatedIds": [
        "grammar.existence"
      ]
    },
    {
      "id": "grammar.polite",
      "title": "〜ます: вежливая форма",
      "explanation": "Основа глагола + ます образует вежливую непрошедшую форму: настоящее, привычное или будущее действие. 行く → 行きます; 飲む → 飲みます.",
      "examples": [
        {
          "text": "水を飲みます。",
          "translation": "Пью воду.",
          "hiragana": "みずをのみます。",
          "romaji": "Mizu o nomimasu.",
          "literal": "Воду [объект] пью.",
          "natural": "Пью воду.",
          "segments": [
            {
              "text": "水",
              "reading": "みず"
            },
            {
              "text": "を"
            },
            {
              "text": "飲",
              "reading": "の"
            },
            {
              "text": "みます。"
            }
          ]
        }
      ],
      "relatedIds": [
        "grammar.progressive"
      ]
    },
    {
      "id": "grammar.existence",
      "title": "に〜がいます: наличие живого",
      "explanation": "Место + に, живое существо + が, затем います: кто-то находится в указанном месте. Известное существо можно выделить темой с は. います — вежливая форма いる.",
      "examples": [
        {
          "text": "公園に猫がいます。",
          "translation": "В парке есть кошка.",
          "hiragana": "こうえんにねこがいます。",
          "romaji": "Kōen ni neko ga imasu.",
          "literal": "Парк [местонахождение] кошка [подлежащее] есть.",
          "natural": "В парке есть кошка.",
          "segments": [
            {
              "text": "公園",
              "reading": "こうえん"
            },
            {
              "text": "に"
            },
            {
              "text": "猫",
              "reading": "ねこ"
            },
            {
              "text": "がいます。"
            }
          ]
        }
      ],
      "relatedIds": [
        "grammar.location",
        "grammar.topic"
      ]
    },
    {
      "id": "grammar.location",
      "title": "で: место действия",
      "explanation": "Частица で указывает, где происходит действие. Для местонахождения с いる используется に.",
      "examples": [
        {
          "text": "木の下で水を飲みます。",
          "translation": "Пью воду под деревом.",
          "hiragana": "きのしたでみずをのみます。",
          "romaji": "Ki no shita de mizu o nomimasu.",
          "literal": "Дерево [связь] низ [место действия] воду [объект] пью.",
          "natural": "Пью воду под деревом.",
          "segments": [
            {
              "text": "木",
              "reading": "き"
            },
            {
              "text": "の"
            },
            {
              "text": "下",
              "reading": "した"
            },
            {
              "text": "で"
            },
            {
              "text": "水",
              "reading": "みず"
            },
            {
              "text": "を"
            },
            {
              "text": "飲",
              "reading": "の"
            },
            {
              "text": "みます。"
            }
          ]
        }
      ],
      "relatedIds": [
        "grammar.existence"
      ]
    },
    {
      "id": "grammar.possession",
      "title": "の: связь существительных",
      "explanation": "Первое существительное определяет второе: 木の下 — место под деревом, 次の日 — следующий день.",
      "examples": [
        {
          "text": "木の下に猫がいます。",
          "translation": "Под деревом есть кошка.",
          "hiragana": "きのしたにねこがいます。",
          "romaji": "Ki no shita ni neko ga imasu.",
          "literal": "Дерево [связь] низ [местонахождение] кошка [подлежащее] есть.",
          "natural": "Под деревом есть кошка.",
          "segments": [
            {
              "text": "木",
              "reading": "き"
            },
            {
              "text": "の"
            },
            {
              "text": "下",
              "reading": "した"
            },
            {
              "text": "に"
            },
            {
              "text": "猫",
              "reading": "ねこ"
            },
            {
              "text": "がいます。"
            }
          ]
        }
      ],
      "relatedIds": [
